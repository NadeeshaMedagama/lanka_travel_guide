# OPTIONAL — Base URL of the json-server mock REST API for LOCAL development.
#
# • Set this (copy this file to `.env`) and run `npm run api` to use the live json-server REST API
#   at http://localhost:3001 — with server-side category filtering and /attractions/:id endpoints.
# • Leave it UNSET (the default in production / Vercel) and the app uses the bundled static snapshot
#   public/attractions.json instead, so the deployed site works with NO backend.
#
# Vite only exposes variables prefixed with VITE_ to client-side code.
VITE_API_URL=http://localhost:3001
